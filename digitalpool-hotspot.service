[Unit]
Description=DigitalPool Camera WiFi Hotspot
Documentation=https://github.com/your-org/digitalpool-camera
# Start after NetworkManager is running so nmcli commands work.
After=NetworkManager.service
Wants=NetworkManager.service
# Hotspot must be up before the camera app AND MediaMTX start so that:
#  1. The admin UI is reachable via WiFi from the very first moment.
#  2. mediamtx-update-hosts.sh (ExecStartPre of mediamtx) finds 192.168.50.1
#     and includes it as a WebRTC ICE candidate — making the preview work
#     over the hotspot even when ethernet is not connected.
Before=digitalpool-camera.service mediamtx.service

[Service]
Type=oneshot
RemainAfterExit=yes

# ExecStart brings up the hotspot; ExecStop tears it down cleanly.
ExecStart=/usr/local/sbin/dp-hotspot.sh
ExecStop=/bin/bash -c '\
    nmcli connection down "DigitalPool-Hotspot" 2>/dev/null || true; \
    IFACE=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | grep :wifi | head -1 | cut -d: -f1); \
    [ -n "$IFACE" ] && iptables -t nat -D PREROUTING -i "$IFACE" -p tcp --dport 80 \
        -j REDIRECT --to-port ${PORT:-3000} 2>/dev/null || true; \
    [ -n "$IFACE" ] && iptables -D INPUT -i "$IFACE" -p tcp --dport 22 -j ACCEPT 2>/dev/null || true'

# Run as root — required for nmcli profile creation and iptables.
User=root

# Increase timeout: USB WiFi dongles can take up to 90 s to enumerate on
# a cold boot; built-in PCIe/M.2 chips appear in ~1 s.  The script waits
# internally (up to 90 s for the interface + up to 60 s for NM state),
# so give systemd enough headroom for either hardware type.
TimeoutStartSec=210

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dp-hotspot

[Install]
WantedBy=multi-user.target
