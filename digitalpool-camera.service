[Unit]
Description=Digital Pool Camera Control Service
After=NetworkManager.service sound.target mediamtx.service
Wants=sound.target NetworkManager.service
Requires=mediamtx.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/digitalpool-camera
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=5

# Logging — view with: journalctl -u digitalpool-camera -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digitalpool-camera

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=CAMERA_DEVICE=/dev/video0

# ── Memory limits ────────────────────────────────────────────────────────────
# Applies to the entire cgroup: Node.js + all child processes (GStreamer, ffmpeg,
# Python overlay pipeline).  The Python/GStreamer process leaked to 3.3 GB after
# 8 h of streaming and was killed by the kernel OOM killer, which also knocked
# out the WiFi driver.  A hard cgroup limit ensures the kernel kills only this
# service's cgroup (cleanly, triggering Restart=always) rather than randomly
# killing drivers or other system processes.
MemoryMax=1500M
MemorySwapMax=0

# ── OOM priority ─────────────────────────────────────────────────────────────
# Lower score = less likely to be chosen by the OOM killer when system-wide
# memory is critically low.  -900 strongly protects Node.js itself so that if
# memory pressure spills outside the cgroup limit the kernel targets other
# processes first.
OOMScoreAdjust=-900

# ── Systemd watchdog ─────────────────────────────────────────────────────────
# Node.js sends WATCHDOG=1 via `systemd-notify` every WatchdogSec/2 seconds.
# NotifyAccess=main is required: without it systemd does not set NOTIFY_SOCKET
# or WATCHDOG_USEC in the process environment, so the keepalive never fires and
# the service is killed every WatchdogSec seconds regardless.
NotifyAccess=main
WatchdogSec=120

[Install]
WantedBy=multi-user.target

