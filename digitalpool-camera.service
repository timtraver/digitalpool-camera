[Unit]
Description=Digital Pool Camera Control Service
After=NetworkManager.service sound.target mediamtx.service
Wants=sound.target NetworkManager.service
Requires=mediamtx.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/digitalpool-camera
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=5

# Logging — view with: journalctl -u digitalpool-camera -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digitalpool-camera

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=CAMERA_DEVICE=/dev/video0

[Install]
WantedBy=multi-user.target

