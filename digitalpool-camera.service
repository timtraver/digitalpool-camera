[Unit]
Description=Digital Pool Camera Control Service
After=NetworkManager.service sound.target mediamtx.service digitalpool-migrations.service
Wants=sound.target NetworkManager.service mediamtx.service digitalpool-migrations.service

[Service]
Type=simple
User=dp
WorkingDirectory=/home/dp/digitalpool-camera
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=5
# Node.js SIGTERM handler kills child processes and calls process.exit() within
# 7 s (hard deadline enforced in server.js _startShutdown).  Give it 10 s here
# so systemd doesn't race ahead with SIGKILL while children are still dying.
# Default is 90 s which made every restart feel hung.
TimeoutStopSec=10
# Kill any surviving Chrome/Chromium child processes after Node.js exits.
# Puppeteer launches Chrome as a subprocess; if Node is killed before its
# SIGTERM handler completes, Chrome's renderer/gpu/zygote children can
# survive as orphans and accumulate across restarts.
# This runs after every stop/crash/restart — it is safe to run even when
# no Chrome is present (pkill exits 1, which is suppressed by || true).
ExecStopPost=/bin/bash -c 'pkill -SIGKILL -f "chromium-browser/chrome" 2>/dev/null || pkill -SIGKILL -f chromium 2>/dev/null || true'

# Logging — view with: journalctl -u digitalpool-camera -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digitalpool-camera

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=CAMERA_DEVICE=/dev/video0

# ── Memory limits ────────────────────────────────────────────────────────────
# Applies to the entire cgroup: Node.js + all child processes (GStreamer, ffmpeg,
# Python overlay pipeline).  The Python/GStreamer process leaked to 3.3 GB after
# 8 h of streaming and was killed by the kernel OOM killer, which also knocked
# out the WiFi driver.  A hard cgroup limit ensures the kernel kills only this
# service's cgroup (cleanly, triggering Restart=always) rather than randomly
# killing drivers or other system processes.
MemoryMax=2500M
MemorySwapMax=0

# ── OOM priority ─────────────────────────────────────────────────────────────
# Lower score = less likely to be chosen by the OOM killer when system-wide
# memory is critically low.  -900 strongly protects Node.js itself so that if
# memory pressure spills outside the cgroup limit the kernel targets other
# processes first.
OOMScoreAdjust=-900

# Per-service WatchdogSec is intentionally omitted.
# With Type=simple, systemd uses WatchdogSec/2 as the effective kill threshold,
# and keepalives from child processes (execFile) are rejected by NotifyAccess=main,
# causing the service to be killed every ~60 s even when healthy.
# Last-resort watchdog protection is provided by the hardware watchdog configured
# in /etc/systemd/system.conf.d/watchdog.conf (RuntimeWatchdogSec=60), which
# reboots the board only if PID 1 / the kernel itself becomes completely unresponsive.

[Install]
WantedBy=multi-user.target

