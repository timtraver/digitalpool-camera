# Server Configuration
PORT=3000

# Camera Configuration
#
# Leave both of these UNSET for normal use. The app discovers whatever USB
# cameras are plugged in, in whatever ports, and assigns them to camera slots by
# USB port order — slot 1 to the camera in the lowest-numbered port, slot 2 to
# the next. Run ./camera-nodes.sh to see what it will find. To assign a specific
# camera to a specific slot, use the UI (Camera Input → Device); that choice is
# persisted as a stable path and survives reboots.
#
# Set them only to force a specific device, and then use a /dev/v4l/by-id/...
# path (by-path preferred — see camera-nodes.sh), never /dev/videoN, because node
# numbers are reassigned by any uvcvideo re-probe
# (usb-reset.sh, USB autosuspend, a driver rebind), with no USB disconnect and no
# other visible symptom. A value that no longer names a present capture device is
# ignored in favour of auto-detection, and the reason is logged.
#
#CAMERA_DEVICE=/dev/v4l/by-id/usb-<vendor>_<product>_<serial>-video-index0
#CAMERA_DEVICE_2=/dev/v4l/by-id/usb-<vendor>_<product>_<serial>-video-index0

SESSION_SECRET=

NETBIRD_MANAGEMENT_URL=https://vpn.digitalpool.com/   # or your self-hosted URL
NETBIRD_SETUP_KEY=
NETBIRD_API_TOKEN=

# DigitalPool device registration (Firebase Cloud Function)
# During registration the device POSTs the operator's DigitalPool email+password
# to this function, which authenticates the account server-side, checks venue
# ownership, records the device + its NetBird IP, and returns the venue(s).
# No Firebase API keys / SDK are stored on the device — only the function URL.
DIGITALPOOL_FUNCTIONS_URL=https://us-central1-digital-pool.cloudfunctions.net
DIGITALPOOL_REGISTER_FUNCTION=registerCameraDevice

# Hotspot network (must match dp-hotspot.sh / the NetworkManager AP profile)
#AP_IP=192.168.50.1
#HOTSPOT_SUBNET=192.168.50.

# ─────────────────────────────────────────────────────────────────────────────
# Performance tuning — all optional. Values shown ARE the defaults; uncomment
# only to override. These reach the GStreamer pipeline because dotenv populates
# process.env and the Python child inherits it.
#
# Background: frame loss in this pipeline is SILENT — the leaky queues drop
# frames rather than erroring, so a throughput ceiling looks like "jerky video"
# and never appears in the logs. Measure delivered frame rate directly:
#
#   ffmpeg -y -rtsp_transport tcp -i rtsp://localhost:8554/live -c copy -t 15 /tmp/c.mp4
#   ffprobe -v error -select_streams v:0 -count_frames \
#     -show_entries stream=nb_read_frames -of csv=p=0 /tmp/c.mp4
#
# At 60fps expect ~845+ over 15 s. The shortfall from 900 is the RTSP client
# waiting for the first keyframe, not dropped frames. ~430 means half rate.
# ─────────────────────────────────────────────────────────────────────────────

# Admin WebRTC preview, per camera. Software-encoded (x264enc) on Intel hosts
# because a second VA-API session corrupts the main stream. Gated on MediaMTX
# reader count: near-free when unwatched, ~63% of a core WHILE SOMEONE WATCHES.
# That means the box is most loaded exactly when an owner opens the admin page,
# so always test with a viewer connected. Clarity comes from resolution and
# smoothness from frame rate — lower PREVIEW_FPS before touching the size.
#PREVIEW_WIDTH=1280
#PREVIEW_HEIGHT=720
#PREVIEW_FPS=10
#PREVIEW_BITRATE_KBPS=2000

# Overlay compositing backend.  ← ROLLBACK LEVER
#   composition (default) — PNG attached to each frame as metadata and blended
#                           in C, directly on NV12. No per-frame Python call and
#                           no BGRA round-trip.
#   cairo                 — previous path: a Python draw callback on every frame.
#                           Correct, but cost ~89% of a core at 1080p60 (PyGObject
#                           marshalling + pycairo under the GIL) and forced an
#                           NV12->BGRA->NV12 conversion, capping delivery near 29fps.
# Set this to 'cairo' if the overlay ever renders wrong (dark fringes on text
# would mean an alpha-handling problem) or fails to appear.
#OVERLAY_MODE=composition

# Colour-conversion backend for the overlay round-trip on Intel. Only reached
# when OVERLAY_MODE=cairo, or when a flip is enabled (videoflip is unreliable
# on NV12 here, so a flip forces the BGRA path).
#   cpu (default) — videoconvert, parallelised across otherwise-idle cores
#   gpu           — vapostproc. SLOWER on this hardware: the iGPU has one
#                   fixed-function VPP unit and vah264enc is already using it to
#                   encode, so conversions serialise behind the encoder.
#OVERLAY_CONVERT=cpu
#VIDEOCONVERT_THREADS=4

# VBR target as a percentage of the bitrate ceiling (Intel vah264enc/vah265enc).
# The va plugin defaults to CBR, which spends full bitrate on a near-static table
# and then has nothing banked for the break. Verify the achieved average after
# changing this — if it lands ~25% above the configured bitrate, this plugin
# build treats 'bitrate' as the target rather than the ceiling.
#VA_TARGET_PERCENTAGE=80

# How often Puppeteer re-screenshots the remote overlay page, in ms. Lower is
# smoother for animated overlays but each capture is a ~1-core PNG encode spike.
# Must be <= half the period of any on-page animation or it aliases.
#OVERLAY_REFRESH_MS=2000