# Server Configuration
PORT=3000

# Camera Configuration
# Use /dev/video0 for most USB cameras
# Run 'v4l2-ctl --list-devices' to find your camera device
CAMERA_DEVICE=/dev/video0

HEADSCALE_URL=https://remote.digitalpool.com
HEADSCALE_AUTHKEY=hskey-auth-your-key-here
# Admin API key — create with: headscale apikeys create --expiration 9999d
# Required for the "Register as New Device" and device rename flows to update
# the Headscale node name (givenName) in addition to the Tailscale hostname.
HEADSCALE_API_KEY=